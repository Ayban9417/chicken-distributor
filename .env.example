# Frontend only. Copy to .env.local for development or configure these variables
# in the production hosting platform. Never reuse the DEV project URL in PROD.
# Use "local" only for the in-memory demonstration mode.
VITE_DATA_MODE=local
VITE_SUPABASE_URL=https://your-environment-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-environment-publishable-key

# Edge Function secrets are configured in Supabase, not in frontend .env files:
# ALLOWED_ORIGINS=https://your-production-frontend.example
# INTERNAL_AUTH_DOMAIN=accounts.your-company.example
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
